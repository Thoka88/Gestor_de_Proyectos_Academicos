@model List<GestorAcademicoEntities.Proyecto>

@{
    ViewData["Title"] = "Proyectos del Curso";
}

<head>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <script defer src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/proyectoestudiantejs/proyectoestudiante.js"></script>
	<link href="~/css/proyectoestudiantecss/proyectoestudiante.css" rel="stylesheet" />
</head>

<body class="fondo-vistaEst">


    <div class="container mt-4">

        <h2 class="text-white mb-4">
            Proyectos del curso: @ViewBag.NombreCurso
        </h2>

        @if (Model != null && Model.Any())
        {
            <div class="row mt-4">

                @foreach (var p in Model)
                {
                    <div class="col-md-4 mb-4">
                        <div class="ColorCard h-100 border-0">

                            <div class="card-body">
                                <h5 class="card-title">@p.Nombre_Proyecto</h5>

                                <p class="card-text mb-1"><strong>Estado:</strong> @p.Estado_Proyecto</p>
                                <p class="card-text mb-1"><strong>Inicio:</strong> @p.Fecha_Inicio.ToShortDateString()</p>
                                <p class="card-text"><strong>Finalización:</strong> @p.Fecha_Finalizacion.ToShortDateString()</p>

                                <hr />

                                <a asp-action="DetalleProyecto"
                                   asp-route-idProyecto="@p.Id_Proyecto"
                                   asp-route-idCurso="@ViewBag.IdCurso"
                                   class="btn BtnProy">
                                    Ver tareas
                                </a>

                            </div>
                        </div>
                    </div>
                }

            </div>
        }
        else
        {
            <div class="alert alert-info mt-4">
                No hay proyectos registrados para este curso.
            </div>
        }

        <a asp-controller="Estudiante"
           asp-action="VistaEstudiante"
           class="btn BtnProy">
            Volver a mis cursos
        </a>

    </div>

</body>

@model List<GestorAcademicoEntities.Tarea>

@{
    ViewData["Title"] = "Mis tareas del proyecto";
    int idProyecto = ViewBag.IdProyecto;
    int idCurso = ViewBag.IdCurso;
}

<head>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <script defer src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/proyectoestudiantejs/detalleproyectoest.js"></script>
	<link href="~/css/proyectoestudiantecss/detalleproyectoest.css" rel="stylesheet" />
</head>


<body class="fondoDetalEst">

    <div class="container mt-4">

        <h2 style="color:white ">Mis tareas en el proyecto</h2>

        <div class="d-flex justify-content-end mb-3">
            <a asp-controller="ProyectoEstudiante"
               asp-action="ReportePersonalEstudiante"
               asp-route-idCurso="@idCurso"
               asp-route-idProyecto="@idProyecto"
               class="btn BtnProyVerd ">
                Ver mi reporte de avance
            </a>
        </div>

   
        <div >
            <div class="ColorCard">
                <h2 class="ColorCard text-white">
                    Crear nueva tarea
                </h2>
                <form asp-action="AgregarTarea" method="post">
                    <input type="hidden" name="Id_Proyecto" value="@idProyecto" />
                    <input type="hidden" name="idCurso" value="@idCurso" />

                    <div class="Textbox col-md-12">
                        <input type="text" id="tituloTarea" name="Titulo_Tarea" required>
                        <label for="tituloTarea" class="label">Título</label>
                        <div class="underline"></div>
                    </div>

                    <div class="TextBoxArea col-md-12">
                        <textarea id="descripcionTarea" name="Descripcion_Tarea" rows="3" required></textarea>
                        <label for="descripcionTarea" class="label">Descripción</label>
                        <div class="underline"></div>
                    </div>

                    <div class="Textbox col-md-6 fijoArriba">
                        <input type="date" id="fechaLimite" name="Fecha_Finalizacion" required>
                        <label for="fechaLimite" class="label">Fecha límite</label>
                        <div class="underline"></div>
                    </div>


                    <input type="hidden" name="Estado_Tarea" value="Pendiente" />

                    <button type="submit" class="btn BtnProyVerd">
                        Guardar tarea
                    </button>
                </form>
            </div>
        </div>

      
        <div class="ColorCard mt-4">
            <h2
                class="ColorCard text-white">
                Mis tareas en este proyecto
            </h2>

            <div class="card-body p-0">
                @if (Model != null && Model.Any())
                {
                    <table class="table table-light table-striped table-bordered align-middle">
                        <thead class="table-primary">
                            <tr>
                                <th>Título</th>
                                <th>Descripción</th>
                                <th>Estado</th>
                                <th>Fecha límite</th>
                                <th style="width:220px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model)
                            {
                                <tr>
                                    <td>@t.Titulo_Tarea</td>
                                    <td>@t.Descripcion_Tarea</td>
                                    <td>@t.Estado_Tarea</td>
                                    <td>@t.Fecha_Finalizacion.ToShortDateString()</td>

                                    <td>
                                        
                                        <form asp-action="EditarTarea" method="post" style="display:inline;">
                                            <input type="hidden" name="Id_Tarea" value="@t.Id_Tarea" />
                                            <input type="hidden" name="Id_Proyecto" value="@t.Id_Proyecto" />
                                            <input type="hidden" name="idCurso" value="@idCurso" />

                                            <select name="Estado_Tarea" class="dropdown">
                                                <option value="Pendiente" selected="@(t.Estado_Tarea == "Pendiente")">Pendiente</option>
                                                <option value="En progreso" selected="@(t.Estado_Tarea == "En progreso")">En progreso</option>
                                                <option value="Completada" selected="@(t.Estado_Tarea == "Completada")">Completada</option>
                                            </select>

                                            <button type="submit" class="btn BtnProyVerd">Guardar</button>
                                        </form>

                                        
                                        <form asp-action="EliminarTarea" method="post" style="display:inline;">
                                            <input type="hidden" name="idTarea" value="@t.Id_Tarea" />
                                            <input type="hidden" name="idProyecto" value="@t.Id_Proyecto" />
                                            <input type="hidden" name="idCurso" value="@idCurso" />

                                            <button type="submit" class="btn BtnElim">
                                                Eliminar
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="p-3">
                        <div class="alert alert-info mb-0">
                            Aún no has creado tareas en este proyecto.
                        </div>
                    </div>
                }
            </div>
        </div>

        <a asp-action="VistaProyectosEstudiante"
           asp-route-idCurso="@idCurso"
           class="btn BtnDetProy">
            Volver a mis proyectos
        </a>

    </div>

</body>

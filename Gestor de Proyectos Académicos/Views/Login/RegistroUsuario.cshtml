@{
    ViewData["Title"] = "Registro de usuario";
    var roles = (List<(int Id, string Nombre)>)ViewBag.Roles;
    var cursos = (List<GestorAcademicoEntities.Curso>)ViewBag.Cursos;
}

<div class="container mt-5" style="max-width:700px;">
    <h2 class="mb-4 text-center">Registro de usuario</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form asp-action="RegistroUsuario" method="post">
        <div class="row">
            <div class="mb-3 col-md-6">
                <label class="form-label">Nombre de usuario</label>
                <input type="text" name="nombreUsuario" class="form-control" required />
            </div>
            <div class="mb-3 col-md-6">
                <label class="form-label">Apellidos</label>
                <input type="text" name="apellidos" class="form-control" />
            </div>
        </div>

        <div class="row">
            <div class="mb-3 col-md-6">
                <label class="form-label">Cédula</label>
                <input type="text" name="cedula" class="form-control" />
            </div>
            <div class="mb-3 col-md-6">
                <label class="form-label">Correo electrónico</label>
                <input type="email" name="correo" class="form-control" />
            </div>
        </div>

        <div class="row">
            <div class="mb-3 col-md-6">
                <label class="form-label">Teléfono</label>
                <input type="text" name="telefono" class="form-control" />
            </div>
            <div class="mb-3 col-md-3">
                <label class="form-label">Edad</label>
                <input type="number" name="edad" class="form-control" min="10" max="120" />
            </div>
            <div class="mb-3 col-md-3">
                <label class="form-label">Rol</label>
                <select name="idRol" class="form-select" required>
                    <option value="">Seleccione rol</option>
                    @foreach (var r in roles)
                    {
                        <option value="@r.Id">@r.Nombre</option>
                    }
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Contraseña</label>
            <input type="password" name="contraseña" class="form-control" required />
        </div>

        <hr />

        <div class="mb-3">
            <label class="form-label">Cursos en los que desea participar</label>

            @if (cursos != null && cursos.Any())
            {
                <div class="row">
                    @foreach (var c in cursos)
                    {
                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="cursosSeleccionados"
                                       value="@c.Id_Curso"
                                       id="curso_@c.Id_Curso" />
                                <label class="form-check-label" for="curso_@c.Id_Curso">
                                    @c.NombreCurso (@c.CodigoCurso)
                                </label>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-warning mt-2">
                    No hay cursos registrados en el sistema.
                </div>
            }
        </div>

        <button type="submit" class="btn btn-primary w-100">Registrarme</button>

        <div class="mt-3 text-center">
            <a asp-action="Login">Ya tengo cuenta, ir al login</a>
        </div>
    </form>
</div>

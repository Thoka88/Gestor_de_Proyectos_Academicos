@{
    Layout = null;
}

<head>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <script defer src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script defer src="~/js/iniciosesionjs/iniciosesion.js"></script>
	<link href="~/css/logincss/login.css" rel="stylesheet" />
</head>

<body class ="fondo-login">
    <div class="container">
        <div class="row align-items-center vh-100">
            <div class="col-md-6 text-center">
				<img src="~/resources/login/personaslogin.svg" />
            </div>

            <div class="col-md-6 InicioSesion">
                <h3 class="text-center mb-4">Iniciar sesión</h3>

                <form asp-action="Login" asp-controller="Login" method="post">
                    <div class="TextBoxLogin mb-3">
                         <input type="text" id="usuario" name="nombreUsuario" required>
                         <label for="usuario" class="label">Usuario</label>
                         <div class="underline"></div>
                     </div>

                    <div class="TextBoxLogin mb-3">
                        <input type="password" id="contrasena" name="contraseña" required>
                        <label for="contrasena" class="label">Contraseña</label>
                        <div class="underline"></div>
                    </div>
                    <div class="LinkRef text-center">
                        <a href="#">¿Olvidaste tu contraseña?</a>
                    </div>

 @*                    <div class="mb-3 form-check d-flex align-items-center gap-2">
                        <label class="checkBox">
                            <input type="checkbox" id="recordar">
                            <svg viewBox="0 0 64 64" height="1.8em" width="1.8em">
                                <path d="M 0 16 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 16 L 32 48 L 64 16 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 16"
                                      pathLength="575.0541381835938"
                                      class="path"></path>
                            </svg>
                        </label>

                        <label for="recordar" class="form-check-label">Recordarme</label>
                    </div> *@

                    <div class="text-center">
                        <button type="submit" class="BtnLogin">Ingresar</button>
                    </div>

                    <div class="LinkRef text-center">
                        <a asp-action="RegistroUsuario">¿No tenés cuenta? Registrate aquí</a>
                    </div>

                </form>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger mt-3 text-center">@ViewBag.Error</div>
                }
            </div>
        </div>
    </div>
</body>



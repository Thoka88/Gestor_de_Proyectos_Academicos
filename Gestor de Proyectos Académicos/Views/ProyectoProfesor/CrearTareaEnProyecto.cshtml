@{
    ViewData["Title"] = "Crear tarea para estudiante";
}

<head>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <script defer src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/proyectoprofesorjs/creartarea.js"></script>
	<link href="~/css/proyectoprofesorcss/creartarea.css" rel="stylesheet" />
</head>


<body class="fondoCreTar">

    <div class="container mt-4">
        <h3 style="color:white">Asignar tarea al estudiante (Id: @ViewBag.IdUsuario)</h3>
        <hr />

        <form asp-action="CrearTareaEnProyecto" method="post">
            <input type="hidden" name="idProyecto" value="@ViewBag.IdProyecto" />
            <input type="hidden" name="idCurso" value="@ViewBag.IdCurso" />
            <input type="hidden" name="idUsuario" value="@ViewBag.IdUsuario" />

            <div class="Textbox col-md-12">
                <input type="text" id="tituloTarea" name="titulo" required>
                <label for="tituloTarea" class="label">Título de la tarea</label>
                <div class="underline"></div>
            </div>

            <div class="TextBoxArea col-md-12">
                <textarea id="descripcionTarea" name="descripcion" rows="3" required></textarea>
                <label for="descripcionTarea" class="label">Descripción</label>
                <div class="underline"></div>
            </div>

            <div class="row">
                <div class="Textbox col-md-6 fijoArriba">
                    <input type="date" id="fechaInicio" name="fechaInicio" required>
                    <label for="fechaInicio" class="label">Fecha inicio</label>
                    <div class="underline"></div>
                </div>

                <div class="Textbox col-md-6 fijoArriba">
                    <input type="date" id="fechaFin" name="fechaFin" required>
                    <label for="fechaFin" class="label">Fecha fin</label>
                    <div class="underline"></div>
                </div>
            </div>


            <button type="submit" class="btn BtnProyVerd">
               Guardar tarea
            </button>

            <a asp-action="DetalleProyecto"
               asp-route-idProyecto="@ViewBag.IdProyecto"
               asp-route-idCurso="@ViewBag.IdCurso"
               class="btn BtnCrearT">
                Cancelar
            </a>
        </form>
    </div>

</body>

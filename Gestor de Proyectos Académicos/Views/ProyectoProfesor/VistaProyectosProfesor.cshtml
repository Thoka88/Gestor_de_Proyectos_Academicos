@model List<GestorAcademicoEntities.Proyecto>

@{
    ViewData["Title"] = "Proyectos del Curso";
}

<head>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <script defer src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script  src="~/js/ProyectoProfesorJS/ProyectoProfesor.js"></script>
	<link href="~/css/proyectoprofesorcss/proyectoprofesor.css" rel="stylesheet" />
</head>


<h2 style ="color:white">
    Proyectos del curso: @ViewBag.NombreCurso
</h2>

<body class="fondo-vistaProf">


    <div>

        <form asp-action="AgregarProyecto" method="post" class="mb-4 formulario-proyecto">
            <input type="hidden" name="Id_Curso" value="@ViewBag.IdCurso" />

            <div class="row g-2 align-items-center formulario-proyecto-row">

                <div class="Textbox mb-3">
                    <input type="text" id="nombreProyecto" name="Nombre_Proyecto" required>
                    <label for="nombreProyecto" class="label">Nombre del proyecto</label>
                    <div class="underline"></div>
                </div>

                <div class="Textbox mb-3">
                    <input type="text" id="descripcionProyecto" name="Descripcion_Proyecto" required>
                    <label for="descripcionProyecto" class="label">Descripción</label>
                    <div class="underline"></div>
                </div>

                <div class="Textbox mb-3 fijoArriba">
                    <input type="date" id="fechaInicio" name="Fecha_Inicio" required>
                    <label for="fechaInicio" class="label">Fecha de inicio</label>
                    <div class="underline"></div>
                </div>

                <div class="Textbox mb-3 fijoArriba">
                    <input type="date" id="fechaFinalizacion" name="Fecha_Finalizacion" required>
                    <label for="fechaFinalizacion" class="label">Fecha de finalización</label>
                    <div class="underline"></div>
                </div>

                <div class="col-md-2 campo-proyecto">
                    <button type="submit"
                            class="btn BtnProyVerd">
                             Agregar
                    </button>
                </div>

            </div>
        </form>


        @if (Model != null && Model.Any())
        {
            <table class="table table-light table-striped table-bordered align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>Nombre</th>
                        <th>Estado</th>
                        <th>Inicio</th>
                        <th>Finalización</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>

                            <td class="col-nombre">@p.Nombre_Proyecto</td>
                            <td class="col-estado">@p.Estado_Proyecto</td>
                            <td class="col-fecha">@p.Fecha_Inicio.ToShortDateString()</td>
                            <td class="col-fecha">@p.Fecha_Finalizacion.ToShortDateString()</td>

                            <td class="col-acciones">

                                <a asp-action="ReporteProyecto"
                                   asp-route-idProyecto="@p.Id_Proyecto"
                                   asp-route-idCurso="@ViewBag.IdCurso"
                                   class="btn BtnProyNig">
                                   Ver reporte
                                </a>

                                <a asp-action="DetalleProyecto"
                                   asp-route-idProyecto="@p.Id_Proyecto"
                                   asp-route-idCurso="@ViewBag.IdCurso"
                                   class="btn BtnProyNig">
                                   Ver estudiantes
                                </a>

                               

                                <form asp-action="EliminarProyecto"
                                      method="post"
                                      class="form-eliminar-proyecto d-inline">
                                    <input type="hidden" name="idProyecto" value="@p.Id_Proyecto" />
                                    <input type="hidden" name="idCurso" value="@ViewBag.IdCurso" />

                                    <button type="submit"
                                            class="btn BtnProyElim">
                                             Eliminar
                                    </button>
                                </form>

                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info mensaje-no-proyectos">
                No hay proyectos registrados para este curso.
            </div>
        }

		<a 
           asp-controller="Profesor"
           asp-action="VistaProfesor"
		   class="btn BtnProy">
            Volver a mis cursos
        </a>

    </div>
</body>
@if (TempData["ProyectoAgregado"] != null)
{
    <script>
        AlertaProyectoAgregado();
    </script>
}
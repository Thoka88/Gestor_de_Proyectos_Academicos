@model List<GestorAcademicoEntities.Proyecto>

@{
    ViewData["Title"] = "Proyectos del Curso";
}

<head>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <script defer src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/proyectoprofesorjs/proyectoprofesor.js"></script>
	<link href="~/css/proyectoprofesorcss/proyectoprofesor.css" rel="stylesheet" />
</head>


<h2 style ="color:white">
    Proyectos del curso: @ViewBag.NombreCurso
</h2>

<body class="fondo-vistaProf">
    <div>

        <!-- Formulario para agregar proyecto -->
        <form asp-action="AgregarProyecto" method="post" class="mb-4 formulario-proyecto">
            <input type="hidden" name="Id_Curso" value="@ViewBag.IdCurso" />

            <div class="row g-2 align-items-center formulario-proyecto-row">

                <div class="col-md-3 campo-proyecto">
                    <input name="Nombre_Proyecto"
                           class="form-control"
                           placeholder="Nombre del proyecto"
                           required />
                </div>

                <div class="col-md-3 campo-proyecto">
                    <input name="Descripcion_Proyecto"
                           class="form-control"
                           placeholder="Descripción"
                           required />
                </div>

                <div class="col-md-2 campo-proyecto">
                    <input type="date"
                           name="Fecha_Inicio"
                           class="form-control"
                           required />
                </div>

                <div class="col-md-2 campo-proyecto">
                    <input type="date"
                           name="Fecha_Finalizacion"
                           class="form-control"
                           required />
                </div>

                <div class="col-md-2 campo-proyecto">
                    <button type="submit"
                            class="btn btn-success w-100 btn-agregar-proyecto">
                        <i class="bi bi-plus-circle"></i> Agregar
                    </button>
                </div>

            </div>
        </form>


        @if (Model != null && Model.Any())
        {
            <table class="table table-striped table-bordered align-middle shadow-sm tabla-proyectos">
                <thead class="table-primary">
                    <tr>
                        <th>Nombre</th>
                        <th>Estado</th>
                        <th>Inicio</th>
                        <th>Finalización</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr class="fila-proyecto">

                            <td class="col-nombre">@p.Nombre_Proyecto</td>
                            <td class="col-estado">@p.Estado_Proyecto</td>
                            <td class="col-fecha">@p.Fecha_Inicio.ToShortDateString()</td>
                            <td class="col-fecha">@p.Fecha_Finalizacion.ToShortDateString()</td>

                            <td class="col-acciones">

                                <a asp-action="ReporteProyecto"
                                   asp-route-idProyecto="@p.Id_Proyecto"
                                   asp-route-idCurso="@ViewBag.IdCurso"
                                   class="btn btn-info btn-sm me-2 btn-reporte">
                                    <i class="bi bi-bar-chart"></i> Ver reporte
                                </a>

                                <a asp-action="DetalleProyecto"
                                   asp-route-idProyecto="@p.Id_Proyecto"
                                   asp-route-idCurso="@ViewBag.IdCurso"
                                   class="btn btn-info btn-sm btn-estudiantes">
                                    <i class="bi bi-people"></i> Ver estudiantes
                                </a>

                                <form asp-action="EliminarProyecto"
                                      method="post"
                                      class="form-eliminar-proyecto d-inline">
                                    <input type="hidden" name="idProyecto" value="@p.Id_Proyecto" />
                                    <input type="hidden" name="idCurso" value="@ViewBag.IdCurso" />

                                    <button type="submit"
                                            class="btn btn-danger btn-sm btn-eliminar">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </button>
                                </form>

                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info mensaje-no-proyectos">
                No hay proyectos registrados para este curso.
            </div>
        }

        <a asp-controller="Profesor"
           asp-action="VistaProfesor"
           class="btn btn-outline-secondary mt-3 btn-volver">
            <i class="bi bi-arrow-left"></i> Volver a mis cursos
        </a>

    </div>
</body>
@model List<GestorAcademicoEntities.Curso>

@{
    ViewData["Title"] = "Vista Estudiante";
}
<head>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <script defer src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/estudiantejs/estudiante.js"></script>
	<link href="~/css/estudiantecss/estudiante.css" rel="stylesheet" />
</head>


<h2 style="color:white">
    Bienvenido estudiante @ViewBag.Usuario 🎓
</h2>

<body class="fondo-Est">
    <div class="row mt-4">

        @foreach (var curso in Model)
        {
            <div class="col-md-5 mb-4 ColorCard">

                <div>

                    <div class="InfoBox">

                        <h5 class="card-title fw-bold">
                            @curso.NombreCurso
                        </h5>

                        <p class="card-text mb-1">
                            <i class="bi bi-calendar3"></i>
                            @curso.CodigoCurso
                        </p>

                        <p class="card-text mb-1">
                            <i class="bi bi-building"></i>
                            Aula: @curso.Descripcion
                        </p>

                        <a asp-controller="ProyectoEstudiante"
                           asp-action="VistaProyectosEstudiante"
                           asp-route-idCurso="@curso.Id_Curso"
                           class="btn BtnEst">
                            Ingresar →
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>
</body>
